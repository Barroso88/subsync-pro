# Copie para .env e ajuste. NUNCA faça commit do .env.
WEB_PORT=8484
TZ=Europe/Lisbon

# UID/GID com que o contentor corre. Unraid: 99:100 (nobody:users).
PUID=99
PGID=100

# Pastas no anfitrião (caminhos Unraid de exemplo; defina os seus)
CONFIG_DIR=/mnt/user/appdata/subsync-pro
MOVIES_DIR=/mnt/user/Filmes
SERIES_DIR=/mnt/user/Séries

# Recursos
MEM_LIMIT=1g
CPU_LIMIT=2
SUBSYNC_MAX_JOBS=2
SUBSYNC_LOG_LEVEL=INFO

# Autenticação (recomendado: defina sempre uma palavra-passe)
SUBSYNC_AUTH_PASSWORD=

# Segredos (alternativa: introduzir na interface; ficam em /data/secrets.json com permissões 0600)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
SUBDL_API_KEY=
DEEPL_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
BAZARR_API_KEY=
PLEX_TOKEN=
RADARR_API_KEY=
SONARR_API_KEY=
